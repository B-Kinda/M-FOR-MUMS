<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="Content-Security-Policy" content="
    default-src 'self';
    script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.google.com https://*.googleapis.com https://www.gstatic.com https://cdn.jsdelivr.net;
    style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://accounts.google.com;
    img-src 'self' data: https:;
    font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net data:;
    connect-src 'self' https://*.googleapis.com https://accounts.google.com https://cdn.jsdelivr.net;
    frame-src 'self' https://accounts.google.com https://www.google.com;
    style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://accounts.google.com;
">
  <meta name="google-signin-client_id" content="<%=process.env.GOOGLE_CLIENT_ID%>">

  <!-- CSS Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" 
    rel="stylesheet" 
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" 
    crossorigin="anonymous">
    
    <!-- CSS -->
  <link rel="stylesheet" href="/css/home.page.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/urJourney.css">
  <link rel="stylesheet" href="/css/work.css">
  <link rel="stylesheet" href="/css/copyright.css">
  <link rel="stylesheet" href="/css/signup.css">
  <link href="https://fonts.googleapis.com/css?family=Roboto" rel="stylesheet" type="text/css">
  <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  

  <!-- JS -->
  <script src="/js/homepage.js" defer></script>
  <script src="/js/navbar.js" defer></script>
  <script src="/js/signUp.js" defer></script>
  <script src="https://apis.google.com/js/api:client.js" defer></script>
  <script src="https://apis.google.com/js/platform.js" async defer></script>
  <script src="https://accounts.google.com/gsi/client" async defer></script>

  
  <title>M FOR MUMS</title>
</head>
<body>
  <header class="main-header sticky-top header-custom">
    <nav class="navbar navbar-expand-lg navbar-light shadow-sm">
      <div class="container d-flex align-items-center">
        <!-- Brand/logo -->
        <a class="navbar-brand logo-custom" href="/"><img src="/images/logo.png" alt="logo" class="img-fluid"></a>
        
        <!-- Mobile menu button -->
        <button class="navbar-toggler" 
                type="button" 
                data-bs-toggle="collapse" 
                data-bs-target="#mainNavbar" 
                aria-controls="mainNavbar" 
                aria-expanded="false" 
                aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
  
        <div class="collapse navbar-collapse w-100 ms-0" id="mainNavbar"> 

          <ul class="navbar-nav d-flex w-100 list-unstyled mb-0"> 
            
            <li class="nav-item flex-fill h-100" > 
              <a class="btn btn-nav-custom w-100 h-100 d-flex justify-content-center align-items-center" id="homePage-custom" href="/">Welcome words</a>
            </li>
            <li class="nav-item flex-fill h-100 ">
              <a class="btn btn-nav-custom w-100 h-100 d-flex justify-content-center align-items-center" id="urJourney-custom" href="/yourJourney">Your journey</a>
            </li>
            <li class="nav-item flex-fill h-100 ">
              <a class="btn btn-nav-custom w-100 h-100 d-flex justify-content-center align-items-center" id="work-custom"href="/work">Why work with a PT</a>
            </li>
            <li class="nav-item flex-fill h-100 ">
              <a class="btn btn-nav-custom w-100 h-100 d-flex justify-content-center align-items-center"id="about-custom" href="#">About me</a>
            </li>
            <li class="nav-item flex-fill h-100 ">
              <a class="btn btn-nav-custom w-100 h-100 d-flex justify-content-center align-items-center"id="price-custom" href="#">Price list</a>
            </li>
            <li class="nav-item flex-fill h-100 ">
              <a class="btn btn-nav-custom w-100 h-100 d-flex justify-content-center align-items-center"id="blog-custom" href="#">Blog</a>
            </li>
            <li class="nav-item flex-fill h-100 ">
              <a class="btn btn-nav-custom w-100 h-100 d-flex justify-content-center align-items-center"id="contact-custom" href="#">Contact</a>
            </li>
            <li class="nav-item flex-fill h-100 ">
              <a class="btn btn-nav-custom w-100 h-100 d-flex justify-content-center align-items-center"id="contact-custom" href="/signup">Connexion</a>
            </li>
          </ul>
        </div>
        <div class="ms-auto d-flex align-items-center">
    <% if (locals.isAuthenticated && locals.user) { %>
        <!-- Affiché quand l'utilisateur est connecté -->
        <div class="dropdown">
            <button class="btn btn-link text-decoration-none dropdown-toggle d-flex align-items-center" 
                   type="button" 
                   id="profileDropdown" 
                   data-bs-toggle="dropdown" 
                   aria-expanded="false">
                <img src="<%= user.photo || '/images/default-avatar.png' %>" 
                     alt="Photo de profil" 
                     class="rounded-circle me-2"
                     style="width: 32px; height: 32px; object-fit: cover;">
                <span class="text-dark"><%= user.name || 'Mon Profil' %></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                <li><a class="dropdown-item" href="/profile"><i class="fas fa-user me-2"></i>Mon Profil</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" href="/auth/logout"><i class="fas fa-sign-out-alt me-2"></i>Déconnexion</a></li>
            </ul>
        </div>
    <% } else { %>
        <!-- Bouton de connexion Google -->
        <div class="d-flex align-items-center">
            <div id="g_id_onload"
                 data-client_id="<%=process.env.GOOGLE_CLIENT_ID%>"
                 data-callback="onSignIn"
                 data-auto_prompt="false">
            </div>
            <div class="g_id_signin"
                 data-type="standard"
                 data-size="small"
                 data-theme="outline"
                 data-text="sign_in_with"
                 data-shape="rectangular"
                 data-logo_alignment="left">
            </div>
        </div>
    <% } %>
</div>
    </div>
    </nav>
  </header>
  
  <main>