<%- include('partials/header') %>

<!-- Google Sign In Button - Version personnalisée -->

<section class="auth-section">
    <div class="auth" id="auth">
        <div class="sign-up">
        <form id="signup-form">
            <h1>Create Account</h1>
            <div class="or-separator">
                <div class="google-btn-container">
                    <div class="g_id_signin custom-google-btn"
                        data-type="icon"
                        data-shape="circle"    
                        data-theme="outline"
                        data-text="signin_with"
                        data-size="large"
                        data-logo_alignment="left"
                        data-width="300">
                    </div>
                </div>
            </div>
                <span class="text-center">or use email for registration</span>
                <input type="text" placeholder="Name" />
                <input type="text" placeholder="Email" />
                <input type="password" placeholder="Password" />
                    <button>Sign Up</button>
        </form>
    </div>
    <div class="sign-in">
        <form id="signin-form">
            <h1>Sign In</h1>
                <div class="or-separator">
                <div class="google-btn-container">
                    <div class="g_id_signin custom-google-btn"
                        data-type="icon"
                        data-shape="circle"    
                        data-theme="outline"
                        data-text="signin_with"
                        data-size="large"
                        data-logo_alignment="left"
                        data-width="300">
                    </div>
                </div>  
            </div>
                <span class="text-center">or use email password</span>
                <input type="text" placeholder="Email" />
                <input type="password" placeholder="Password" />
                    <a href="#">Forgot password</a>
                        <button>Sign In</button>
        </form>
        </div>
        <div class="toogle-auth">
        <div class="toogle">
            <div class="toogle-panel toogle-left">
                <h1>Welcome !</h1>
                    <p>If you already have an account</p>
                        <button class="hidden" id="login">Sign In</button>
            </div>
                <div class="toogle-panel toogle-right">
                    <h1>Hello !</h1>
                        <p>If you don't have an account</p>
                            <button class="hidden" id="register">Sign Up</button>
                </div>
            </div>
        </div>
    </div>
</section>
<%- include('partials/footer') %>
